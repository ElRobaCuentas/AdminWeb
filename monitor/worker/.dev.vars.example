# Solo loopback y namespace demo. No habilita Firebase remoto.
RTDB_ORIGIN=http://127.0.0.1:9000
RTDB_NAMESPACE=demo-el-burrito-i03i04
BUS_ID=PULSO-TEST
# Token temporal de Firebase Auth Emulator; no usar owner ni credenciales administrativas.
