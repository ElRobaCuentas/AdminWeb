# Parámetros explícitos para la comprobación local, no política de producción.
PUBLICATION_STALE_AFTER_MS=180000
RECOVERY_CONFIRMATIONS_REQUIRED=2
MAX_FUTURE_SKEW_MS=5000
READ_TIMEOUT_MS=5000
