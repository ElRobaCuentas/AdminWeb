{
  "name": "pulso-monitor-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787 --test-scheduled",
    "watch:local": "node scripts/watch-local.ts",
    "test": "node --test tests/readAndEvaluate.test.ts tests/trackingStore.test.ts tests/scheduled.test.ts tests/watchLocal.test.ts tests/pulsoRead.test.ts",
    "test:memory": "node --test tests/trackingStore.test.ts",
    "test:integration": "node --test tests/rtdb.integration.test.ts",
    "test:api:integration": "node scripts/test-api-local.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261112.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "wrangler": "4.161.0"
  }
}
