{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pulso-monitor-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "dev": { "ip": "127.0.0.1", "port": 8787, "local_protocol": "http" },
  "vars": { "PULSO_LOCAL_ONLY": "true" }
}
